# ---------------------------------------------------------------------------
# Tejas Academy — environment configuration
# Copy this file to `.env.local` and fill in the values you have confirmed.
# Leave a value empty if it is not ready yet: the website hides or replaces
# the related feature with an honest "contact us" message instead of
# inventing information.
#
# NOTE: every VITE_* value is compiled into the public website bundle.
# Only put information here that is meant to be public. Never add secrets.
# ---------------------------------------------------------------------------

# Public website address, without a trailing slash. Used for canonical URLs,
# Open Graph tags, structured data and sitemap.xml.
# Example: https://www.tejasacademy.in
VITE_SITE_URL=

# Public phone number for click-to-call, in international format.
# Example: +91XXXXXXXXXX
VITE_PHONE_NUMBER=

# WhatsApp Business number, in international format (digits, optional +).
# Example: +91XXXXXXXXXX
VITE_WHATSAPP_NUMBER=

# Public contact email address.
VITE_EMAIL=

# Endpoint that accepts enquiry form submissions as a JSON POST request
# (e.g. Formspree, Getform, a Google Apps Script web app or your own API).
# Leave empty to use the WhatsApp enquiry fallback.
VITE_ENQUIRY_ENDPOINT=

# Google Maps embed URL ("Share" → "Embed a map" → copy the src="..." value).
# Leave empty to show a map placeholder with a Get Directions link.
VITE_MAP_EMBED_URL=

# Optional: exact Google Maps place link for the Get Directions button.
# When empty, directions are generated from the address text.
VITE_MAP_PLACE_URL=

# Set to "true" only after you have added an analytics tag (e.g. GA4 / GTM)
# to index.html and updated the privacy policy accordingly.
VITE_ANALYTICS_ENABLED=false

# Optional: "Write a review" link from your Google Business Profile.
# Shows a "Review us on Google" button in the reviews section.
VITE_GOOGLE_REVIEW_URL=
